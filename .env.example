# Configurações do Agente Soberano (Nexus Quant Solana)
PORT=5000
NODE_ENV=development

# Carteira Oficial Phantom (Janio)
AGENT_SOLANA_PUBLIC_KEY=FBx2SKLDLsdeLM8owxU8MNVPKAfJpLpmpHHRgiZDqBoi
# Insira sua chave privada da Phantom abaixo (NUNCA versione este arquivo):
AGENT_SOLANA_PRIVATE_KEY=

# RPC Solana (Mainnet)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Jupiter Swap API V2 (Meta-Aggregator + RTSE + managed landing)
JUPITER_API_KEY=
JUPITER_V2_BASE_URL=https://api.jup.ag/swap/v2
JUPITER_V2_EXECUTE_TIMEOUT_MS=30000
JUPITER_RATE_LIMIT_MS=1050
# General bucket capacity used by exit-protection admission control.
# Free = 1 RPS; update only to the provider-approved plan capacity.
JUPITER_GENERAL_RPS=1
JUPITER_QUOTE_CACHE_TTL_MS=750

# CAPITAL DINÂMICO
# Cada posição busca 10% do patrimônio: caixa + valor executável das posições abertas.
ENTRY_EQUITY_PCT=0.10
# Duas posições podem consumir juntas até 20% do patrimônio, nunca mais de 0.10 SOL.
MAX_TOTAL_ALLOCATION_PCT=0.20
MAX_TOTAL_ALLOCATION_SOL=0.10
# Piso técnico da escada; permite reduzir a ordem sem ultrapassar o teto de 750 bps.
MIN_EXECUTABLE_ENTRY_SOL=0.001
# Reserva de saída proporcional, com limites técnicos mínimo e máximo.
GAS_RESERVE_EQUITY_PCT=0.10
MIN_GAS_RESERVE_SOL=0.01
MAX_GAS_RESERVE_SOL=0.05

# Laya upstream original — usar preferencialmente o proxy privado Railway.
SOLANA_LAYA_NATIVE_URL=http://nexus-decisor-laya.railway.internal:8001
SOLANA_LAYA_PRIVATE_PROXY=true
SOLANA_LAYA_SHADOW_ENABLED=true
SOLANA_LAYA_TIMEOUT_MS=4000
SOLANA_LAYA_MIN_CONFIDENCE=0.85
SOLANA_LAYA_TACTICAL_MODE=SHADOW
SOLANA_LAYA_POSITION_INTERVAL_MS=10000
# Somente para endpoint público: SOLANA_LAYA_AUTH_TOKEN / SOLANA_LAYA_API_KEY.
# No proxy privado Railway, o bearer é injetado pelo proxy e não é distribuído ao cliente.
MERCADO_FINANCEIRO_INTERNAL_URL=http://operacional.railway.internal:4000
NEXUS_CEREBRO_INTERNAL_URL=http://nexus-cerebro.railway.internal:3000

# Hub de Comunicação WhatsApp
COMUNICACAO_API_URL=https://comunicacao-hub-production.up.railway.app
COMUNICACAO_API_KEY=
COMUNICACAO_INSTANCE=financas
WHATSAPP_ADMIN_NUMBER=5521977440606


# Admin Web (mesmo padrão conceitual do Mercado Financeiro)
# Opcional: se ADMIN_EMAIL + ADMIN_PASSWORD existirem, o admin é bootstrapado automaticamente.
# Sem essas variáveis, o primeiro cadastro pela página exige o NEXUS_ADMIN_TOKEN existente.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador Nexus Solana
SOLANA_JWT_SECRET=
NEXUS_ADMIN_TOKEN=

# Recuperação automática de rent de contas SPL vazias.
# Fecha somente contas cujo amount atômico é exatamente zero.
AUTO_RENT_RECOVERY_ENABLED=false
AUTO_RENT_RECOVERY_INTERVAL_MS=1800000

# PUMP.FUN OBSERVATORY — somente leitura, sem execução de trade
# Detecta CreateEvent on-chain antes dos indexadores e acompanha bonding curves em lote.
PUMP_OBSERVATORY_ENABLED=false
PUMP_OBSERVATORY_REFRESH_MS=15000
PUMP_OBSERVATORY_BATCH_SIZE=50
# Correlação Pump birth -> DexScreener first-seen/ready (somente leitura).
PUMP_DEX_TIMING_INTERVAL_MS=5000
PUMP_DEX_TIMING_BATCH_SIZE=30
PUMP_DEX_TIMING_MAX_AGE_MS=900000

# Strategy Lab Pump/Jupiter — SHADOW, sem assinatura ou broadcast
# Ativo somente quando PUMP_OBSERVATORY_ENABLED=true; sai da fila quando proteção real precisa da capacidade.
# Testa a escada dinâmica da banca; este lote é apenas o fallback antes do primeiro snapshot de capital.
PUMP_STRATEGY_LAB_ENABLED=true
PUMP_STRATEGY_LAB_INTERVAL_MS=5000
PUMP_STRATEGY_SHADOW_ENTRY_LAMPORTS=1000000
PUMP_STRATEGY_NETWORK_FEE_LAMPORTS=5000
PUMP_STRATEGY_PRIORITY_FEE_LAMPORTS=0

# Direct Pump bonding-curve SELL fallback. Proteção de saída apenas; nunca habilita BUY direto.
PUMP_DIRECT_SELL_FALLBACK_ENABLED=false
