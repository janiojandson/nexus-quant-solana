{
  "name": "nexus-quant-solana",
  "version": "1.0.0",
  "description": "Agente Economico Soberano e Gestor Quantitativo Solana com Sobrevivencia Darwinista",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && node -e \"require('fs').mkdirSync('dist/database', {recursive: true}) && require('fs').copyFileSync('src/database/schema_decision_journal.sql', 'dist/database/schema_decision_journal.sql')\"",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "tsx --test src/**/*.test.ts test/**/*.test.ts",
    "db:reset-ledger": "tsx scripts/resetLedger.ts",
    "trade:canary": "tsx scripts/testCanaryTrade.ts",
    "trade:preflight-exit": "tsx scripts/validateExitNoBroadcast.ts",
    "trade:rescue": "tsx scripts/rescueJup.ts",
    "token:purge-ci": "tsx scripts/purgeOrphanToken.ts"
  },
  "keywords": [
    "solana",
    "autonomous-agent",
    "trading",
    "dex",
    "jupiter",
    "laya",
    "memecoins"
  ],
  "author": "Janio Jandson",
  "license": "MIT",
  "dependencies": {
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.0",
    "@types/pg": "^8.23.1",
    "axios": "^1.7.9",
    "bcryptjs": "^3.0.3",
    "bip39": "^3.1.0",
    "bs58": "^6.0.0",
    "dotenv": "^16.4.7",
    "ed25519-hd-key": "^2.0.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
